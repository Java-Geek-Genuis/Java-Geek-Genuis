<Page x:Class="CommodoreWarpUWP.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#050814" Loaded="OnLoaded" KeyDown="KeyDown" KeyUp="KeyUp">
<Grid Padding="10">
<Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border Grid.Row="0" Background="Black" BorderBrush="#283E6A" BorderThickness="2" CornerRadius="8" Margin="0,0,0,8"><Image x:Name="ScreenImage" Stretch="Uniform"/></Border>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="95"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
<TextBlock Grid.Column="0" x:Name="MachineText" Text="C64" Foreground="#5DE3FF" FontSize="20" VerticalAlignment="Center"/>
<ToggleSwitch Grid.Column="1" OffContent="C64" OnContent="C128" Toggled="Machine_Toggled"/>
<TextBlock Grid.Column="2" x:Name="SpeedText" Text="1.0x" Foreground="White" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Right"/>
<Slider Grid.Column="3" x:Name="SpeedSlider" Minimum="1" Maximum="16" StepFrequency="1" Value="1" ValueChanged="SpeedChanged"/>
<Button Grid.Column="4" Content="LOAD" Style="{StaticResource WarpButtonStyle}" Click="Load_Click"/>
</Grid>
<TextBlock Grid.Row="1" Text="1×      4×      8×      16×" Foreground="#65779B" HorizontalAlignment="Center" Margin="0,40,0,0" IsHitTestVisible="False"/>
<TextBlock x:Name="StatusText" Grid.Row="1" Foreground="#AAB8D6" TextWrapping="Wrap" Margin="4,42,4,2"/>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
<StackPanel Grid.Column="0" Orientation="Horizontal">
<Button Content="◀" Tag="L" Style="{StaticResource WarpButtonStyle}" Width="58" Height="58" PointerPressed="TouchPressed" PointerReleased="TouchReleased" PointerCanceled="TouchReleased" PointerCaptureLost="TouchReleased"/>
<Button Content="▶" Tag="R" Style="{StaticResource WarpButtonStyle}" Width="58" Height="58" PointerPressed="TouchPressed" PointerReleased="TouchReleased" PointerCanceled="TouchReleased" PointerCaptureLost="TouchReleased"/>
<Button Content="▲" Tag="U" Style="{StaticResource WarpButtonStyle}" Width="58" Height="58" PointerPressed="TouchPressed" PointerReleased="TouchReleased" PointerCanceled="TouchReleased" PointerCaptureLost="TouchReleased"/>
<Button Content="▼" Tag="D" Style="{StaticResource WarpButtonStyle}" Width="58" Height="58" PointerPressed="TouchPressed" PointerReleased="TouchReleased" PointerCanceled="TouchReleased" PointerCaptureLost="TouchReleased"/>
</StackPanel>
<TextBox Grid.Column="1" x:Name="KeyboardBox" PlaceholderText="Tap here and use the phone keyboard to type into BASIC/games" KeyDown="KeyDown" KeyUp="KeyUp" Margin="4"/>
<StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
<Button Content="FIRE" Tag="F" Style="{StaticResource WarpButtonStyle}" Width="72" Height="58" PointerPressed="TouchPressed" PointerReleased="TouchReleased" PointerCanceled="TouchReleased" PointerCaptureLost="TouchReleased"/>
<Button Content="WARP 16×" Style="{StaticResource WarpButtonStyle}" Width="108" Height="58" PointerPressed="WarpPressed" PointerReleased="WarpReleased" PointerCanceled="WarpReleased" PointerCaptureLost="WarpReleased"/>
<Button Content="RESET" Style="{StaticResource WarpButtonStyle}" Width="76" Height="58" Click="Reset_Click"/>
</StackPanel>
</Grid>
</Grid>
</Page>