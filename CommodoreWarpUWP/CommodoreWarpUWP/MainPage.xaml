<Page x:Class="CommodoreWarpUWP.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#050814" Loaded="OnLoaded" KeyDown="KeyDown" KeyUp="KeyUp">
<Grid Padding="10"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border Grid.Row="0" Background="Black" BorderBrush="#283E6A" BorderThickness="2" CornerRadius="8" Margin="0,0,0,8"><Image x:Name="ScreenImage" Stretch="Uniform"/></Border>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="90"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
<TextBlock Grid.Column="0" x:Name="MachineText" Text="C64" Foreground="#5DE3FF" FontSize="20" VerticalAlignment="Center"/>
<ToggleSwitch Grid.Column="1" OffContent="C64" OnContent="C128" Toggled="Machine_Toggled"/>
<StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="CPU " Foreground="#AAB8D6" FontSize="17"/><TextBlock x:Name="CpuText" Text="1.0 MHz" Foreground="White" FontSize="20"/></StackPanel>
<Slider Grid.Column="3" x:Name="CpuSlider" Minimum="1" Maximum="64" StepFrequency="1" Value="1" ValueChanged="CpuChanged"/>
<Button Grid.Column="4" Content="LOAD" Style="{StaticResource WarpButtonStyle}" Click="Load_Click"/><Button Grid.Column="5" Content="PROGRAMS" Style="{StaticResource WarpButtonStyle}" Click="Program_Click"/></Grid>
<TextBlock Grid.Row="1" Text="1 MHz                                            64 MHz" Foreground="#65779B" HorizontalAlignment="Center" Margin="0,40,0,0" IsHitTestVisible="False"/>
<TextBlock x:Name="StatusText" Grid.Row="1" Foreground="#AAB8D6" TextWrapping="Wrap" Margin="4,42,4,2"/>
<Grid Grid.Row="2" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
<StackPanel Grid.Column="0" Orientation="Horizontal">
<Button Content="◀" Tag="L" Style="{StaticResource WarpButtonStyle}" Width="58" Height="58" PointerPressed="TouchPressed" PointerReleased="TouchReleased" PointerCanceled="TouchReleased" PointerCaptureLost="TouchReleased"/><Button Content="▶" Tag="R" Style="{StaticResource WarpButtonStyle}" Width="58" Height="58" PointerPressed="TouchPressed" PointerReleased="TouchReleased" PointerCanceled="TouchReleased" PointerCaptureLost="TouchReleased"/><Button Content="▲" Tag="U" Style="{StaticResource WarpButtonStyle}" Width="58" Height="58" PointerPressed="TouchPressed" PointerReleased="TouchReleased" PointerCanceled="TouchReleased" PointerCaptureLost="TouchReleased"/><Button Content="▼" Tag="D" Style="{StaticResource WarpButtonStyle}" Width="58" Height="58" PointerPressed="TouchPressed" PointerReleased="TouchReleased" PointerCanceled="TouchReleased" PointerCaptureLost="TouchReleased"/></StackPanel>
<TextBox Grid.Column="1" x:Name="KeyboardBox" PlaceholderText="Tap here and use the phone keyboard to type" KeyDown="KeyDown" KeyUp="KeyUp" Margin="4"/>
<StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="FIRE" Tag="F" Style="{StaticResource WarpButtonStyle}" Width="72" Height="58" PointerPressed="TouchPressed" PointerReleased="TouchReleased" PointerCanceled="TouchReleased" PointerCaptureLost="TouchReleased"/><Button Content="WARP 16x" Style="{StaticResource WarpButtonStyle}" Width="108" Height="58" PointerPressed="WarpPressed" PointerReleased="WarpReleased" PointerCanceled="WarpReleased" PointerCaptureLost="WarpReleased"/><Button Content="RESET" Style="{StaticResource WarpButtonStyle}" Width="76" Height="58" Click="Reset_Click"/></StackPanel></Grid>
<Grid x:Name="ProgramPanel" Visibility="Collapsed" Background="#F9050814" Grid.RowSpan="3">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Grid.Row="0" Orientation="Horizontal"><TextBlock Text="C64 PROGRAM LAB" Foreground="White" FontSize="28" FontWeight="SemiBold" Margin="4,4,18,4" VerticalAlignment="Center"/><TextBox x:Name="ProgramName" Text="MYPROGRAM" Width="220" Margin="4"/></StackPanel>
<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="4,2,4,6"><ComboBox x:Name="BuiltInList" Width="330" SelectedIndex="0"><ComboBoxItem Content="[TEST] Hello + keyboard"/><ComboBoxItem Content="[TEST] 16-color display"/><ComboBoxItem Content="[TEST] Screen memory"/><ComboBoxItem Content="[TEST] CPU benchmark"/><ComboBoxItem Content="[GAME] Number Cruncher"/><ComboBoxItem Content="[GAME] Math Blitz"/><ComboBoxItem Content="[GAME] Treasure Hunt"/><ComboBoxItem Content="[GAME] Typing Dash"/><ComboBoxItem Content="[GAME] Letter Hunt"/></ComboBox><Button Content="OPEN BUILT-IN" Style="{StaticResource WarpButtonStyle}" Click="LoadBuiltIn_Click" Height="50" Width="150" Margin="6,0,0,0"/></StackPanel>
<TextBox Grid.Row="2" x:Name="ProgramEditor" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="18" Foreground="#D9F7FF" Background="#02040A" BorderBrush="#2A5270" BorderThickness="2" Padding="10" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" Text="10 PRINT &quot;HELLO FROM C64&quot;&#10;20 GOTO 10"/>
<TextBlock Grid.Row="3" x:Name="SdText" Foreground="#71E6A8" TextWrapping="Wrap" Margin="6,6,6,2" Text="SD workspace: not enabled."/>
<StackPanel Grid.Row="4" HorizontalAlignment="Center">
<StackPanel Orientation="Horizontal"><Button Content="NEW" Style="{StaticResource WarpButtonStyle}" Click="NewProgram_Click" Height="54" Width="85"/><Button Content="LOAD .BAS" Style="{StaticResource WarpButtonStyle}" Click="LoadBasic_Click" Height="54" Width="115"/><Button Content="RUN BASIC" Style="{StaticResource WarpButtonStyle}" Click="RunProgram_Click" Height="54" Width="110"/><Button Content="SAVE LOCAL" Style="{StaticResource WarpButtonStyle}" Click="SaveLocal_Click" Height="54" Width="115"/></StackPanel>
<StackPanel Orientation="Horizontal"><Button Content="ENABLE SD" Style="{StaticResource WarpButtonStyle}" Click="EnableSd_Click" Height="54" Width="110"/><Button Content="SAVE SD" Style="{StaticResource WarpButtonStyle}" Click="SaveSd_Click" Height="54" Width="90"/><Button Content="EXPORT PRG" Style="{StaticResource WarpButtonStyle}" Click="ExportPrg_Click" Height="54" Width="110"/><Button Content="PRG -&gt; SD" Style="{StaticResource WarpButtonStyle}" Click="ExportPrgSd_Click" Height="54" Width="105"/><Button Content="BACK" Style="{StaticResource WarpButtonStyle}" Click="ProgramBack_Click" Height="54" Width="85"/></StackPanel>
</StackPanel></Grid>
</Grid></Page>