<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10" xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10" xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest" IgnorableNamespaces="uap mp">
<Identity Name="CommodoreWarpUWP" Publisher="CN=Java-Geek-Genuis" Version="1.1.0.0" />
<mp:PhoneIdentity PhoneProductId="7D0D4B3D-0E71-4C31-A62F-83C60E9E8D7B" PhonePublisherId="B21E4E6B-1F3A-4F2B-BB3C-3FA4B8F7F5D2" />
<Properties><DisplayName>Commodore Warp</DisplayName><PublisherDisplayName>Java-Geek-Genuis</PublisherDisplayName><Logo>Assets\logo.png</Logo></Properties>
<Dependencies><TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.15063.0" MaxVersionTested="10.0.19041.0" /></Dependencies>
<Resources><Resource Language="x-generate" /></Resources>
<Applications>
<Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="CommodoreWarpUWP.App">
<uap:VisualElements DisplayName="Commodore Warp" Square44x44Logo="Assets\logo.png" Square150x150Logo="Assets\logo.png" Description="C64/C128 emulator with 1-64 MHz effective speed, BASIC editor, PRG export and SD workspace." BackgroundColor="#050814">
<uap:DefaultTile Square71x71Logo="Assets\logo.png" Wide310x150Logo="Assets\logo.png"/>
</uap:VisualElements>
<Extensions><uap:Extension Category="windows.fileTypeAssociation"><uap:FileTypeAssociation Name="commodorefiles"><uap:DisplayName>Commodore files</uap:DisplayName><uap:SupportedFileTypes><uap:FileType>.bas</uap:FileType><uap:FileType>.prg</uap:FileType><uap:FileType>.d64</uap:FileType><uap:FileType>.g64</uap:FileType><uap:FileType>.d81</uap:FileType><uap:FileType>.t64</uap:FileType><uap:FileType>.tap</uap:FileType><uap:FileType>.crt</uap:FileType></uap:SupportedFileTypes></uap:FileTypeAssociation></uap:Extension></Extensions>
</Application>
</Applications>
<Capabilities><uap:Capability Name="removableStorage"/></Capabilities>
</Package>