<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
         IgnorableNamespaces="uap mp">
  <Identity Name="LumiaRiftGame" Publisher="CN=Java-Geek-Genuis" Version="1.0.0.0" />
  <mp:PhoneIdentity PhoneProductId="{D5C67A96-3B7A-4CF3-8F8F-81CDBE0A5EA1}" PhonePublisherId="{A2C2E603-7D0A-4C12-9DE9-B1CC2C86D4D7}" />
  <Properties>
    <DisplayName>Lumia Rift Arcade</DisplayName>
    <PublisherDisplayName>Java-Geek-Genuis</PublisherDisplayName>
    <Logo>Assets\logo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.14393.0" MaxVersionTested="10.0.19041.0" />
  </Dependencies>
  <Resources><Resource Language="x-generate" /></Resources>
  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="LumiaRiftGame.App">
      <uap:VisualElements DisplayName="Lumia Rift Arcade"
        Square44x44Logo="Assets\logo.png" Square150x150Logo="Assets\logo.png"
        Description="Neon arcade action and a permission-first PSP file vault."
        BackgroundColor="#070A16">
        <uap:DefaultTile Square71x71Logo="Assets\logo.png" Square150x150Logo="Assets\logo.png" Wide310x150Logo="Assets\logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>
</Package>
